For H2, this generates 1,100 movies, each with a random release date and 1–3 randomly selected existing tags:

-- Generate 1,100 movies.
-- The shared UUID prefix identifies this batch for tag assignment.
INSERT INTO movie (id, title, release_date)
SELECT
    CAST(
        '30000000-0000-4000-8000-' ||
        LPAD(CAST(x AS VARCHAR), 12, '0')
        AS UUID
    ),
    'Sample Movie ' || CAST(x AS VARCHAR),
    DATEADD(
        'DAY',
        CAST(FLOOR(RAND() * 13149) AS INTEGER),
        DATE '1990-01-01'
    )
FROM SYSTEM_RANGE(1, 1100);

-- Assign up to three distinct tags to each generated movie.
-- If fewer tags exist, use as many as are available.
INSERT INTO movie_tag (movie_id, tag_id)
SELECT movie_id, tag_id
FROM (
    SELECT
        m.id AS movie_id,
        t.id AS tag_id,
        m.tag_count,
        ROW_NUMBER() OVER (
            PARTITION BY m.id
            ORDER BY RAND()
        ) AS tag_position
    FROM (
        SELECT
            id,
            1 + CAST(FLOOR(RAND() * 3) AS INTEGER) AS tag_count
        FROM movie
        WHERE CAST(id AS VARCHAR)
              LIKE '30000000-0000-4000-8000-%'
    ) m
    CROSS JOIN tag t
) assignments
WHERE tag_position <= tag_count;

